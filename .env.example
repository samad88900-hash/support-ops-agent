# Copy this file to .env and fill in real values. Never commit .env.

# --- Model (live mode) ---
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# --- Public API protection (required for /v1/*) ---
# Generate a long random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_KEY

# --- Agent policy ---
REFUND_APPROVAL_LIMIT=5000

# --- Service ---
PORT=8787
RATE_LIMIT_PER_MIN=60
ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Observability ---
AUDIT_ENABLED=true
# AUDIT_LOG_PATH=./data/audit.jsonl
